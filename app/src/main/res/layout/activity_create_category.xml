<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/placa"
    android:scaleType="fitCenter"
    tools:context=".CreateCategoryActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <ImageView
            android:id="@+id/imageForm"
            android:layout_width="126dp"
            android:layout_height="45dp"
            app:srcCompat="@drawable/pane2" />

        <TextView
            android:id="@+id/textForm"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sansitaone"
            android:text="Registra una Categoría"
            android:textAlignment="center"
            android:textColor="#001CAC"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:ems="10"
            android:fontFamily="@font/sansitaone"
            android:hint="Sitio deportivo"
            android:inputType="text"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="59dp"
            android:ems="10"
            android:fontFamily="@font/sansitaone"
            android:hint="Ubicación"
            android:inputType="text"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/panels"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:ems="10"
            android:fontFamily="@font/sansitaone"
            android:hint="# paneles"
            android:inputType="number"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/power"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:ems="10"
            android:fontFamily="@font/sansitaone"
            android:hint="Potencia instalada MWP"
            android:inputType="numberDecimal"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/energy"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:ems="10"
            android:hint="Energía generada"
            android:inputType="numberDecimal"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/co2"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:ems="10"
            android:fontFamily="@font/sansitaone"
            android:hint="% co2"
            android:inputType="numberDecimal"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/life"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:ems="10"
            android:fontFamily="@font/sansitaone"
            android:hint="años vida utíl"
            android:inputType="numberSigned"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <Space
            android:layout_width="454dp"
            android:layout_height="62dp" />

        <Button
            android:id="@+id/button_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#001CAC"
            android:insetLeft="40dp"
            android:insetRight="40dp"
            android:text="Guardar Categoría"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>